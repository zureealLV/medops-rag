# Application
APP_ENV=development
LOG_LEVEL=INFO
AUTH_MODE=trusted_headers
# enterprise: rely on tenant-scoped retrieval evidence; medical: also deny medical advice and out-of-domain queries.
POLICY_PROFILE=enterprise
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1],[::1]:*
MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*
RETRIEVAL_THRESHOLD=0.20
RETRIEVAL_KEYWORD_THRESHOLD=0.28
RETRIEVAL_DENSE_THRESHOLD=0.40
CHUNK_SIZE=600
CHUNK_OVERLAP=80
PARENT_CHUNK_SIZE=1600
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_OVERLAP=50
TEXT_EMBEDDING_ENABLED=false
TEXT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HYDE_AUTO_ENABLED=false
MAX_UPLOAD_BYTES=10000000
MAX_IMAGE_PIXELS=25000000
MAX_ARCHIVE_ENTRIES=2048
MAX_ARCHIVE_UNCOMPRESSED_BYTES=50000000
MAX_ARCHIVE_ENTRY_BYTES=20000000
MAX_ARCHIVE_COMPRESSION_RATIO=200
MAX_PDF_PAGES=200
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.50
IMAGE_EMBEDDING_ENABLED=false
IMAGE_EMBEDDING_MODEL=Qdrant/clip-ViT-B-32-vision
IMAGE_TEXT_EMBEDDING_MODEL=Qdrant/clip-ViT-B-32-text
MODEL_CACHE_DIR=./data/models/fastembed
VISUAL_SIMILARITY_THRESHOLD=0.28
VISUAL_SIMILARITY_MARGIN=0.002

# Database
DATABASE_URL=sqlite:///./data/medops.db

# DeepSeek OpenAI-compatible API. Keep the key in your local .env only.
MODEL_API_KEY=
# DEEPSEEK_API_KEY is accepted as an alias when using an existing external dotenv file.
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_VISION_ENABLED=false
MODEL_MAX_VISUAL_IMAGES=3
MODEL_MAX_VISUAL_BYTES=6000000
EMBEDDING_MODEL_NAME=
MODEL_TIMEOUT_SECONDS=8
MODEL_REQUEST_DEADLINE_SECONDS=12
MODEL_MAX_RETRIES=1
MODEL_RETRY_BASE_DELAY_SECONDS=0.1
MODEL_RETRY_MAX_DELAY_SECONDS=2
MODEL_RETRY_JITTER_RATIO=0.2
MODEL_RETRY_AFTER_MAX_SECONDS=5
MODEL_RETRY_BUDGET_GLOBAL_CAPACITY=32
MODEL_RETRY_BUDGET_GLOBAL_REFILL_PER_SECOND=4
MODEL_RETRY_BUDGET_PER_TENANT_CAPACITY=8
MODEL_RETRY_BUDGET_PER_TENANT_REFILL_PER_SECOND=1
MODEL_MAX_CONCURRENCY=4
MODEL_MAX_CONCURRENCY_PER_TENANT=2
MODEL_MAX_QUEUE_WAITERS=8
MODEL_MAX_QUEUE_WAITERS_PER_TENANT=4
MODEL_QUEUE_TIMEOUT_SECONDS=0.25
MODEL_OVERLOAD_RETRY_AFTER_SECONDS=1
MODEL_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_CIRCUIT_RECOVERY_SECONDS=30
MODEL_SHUTDOWN_TIMEOUT_SECONDS=5
SUMMARY_MODEL_TIMEOUT_SECONDS=30
