# Application
APP_ENV=development
LOG_LEVEL=INFO
RETRIEVAL_THRESHOLD=0.20
CHUNK_SIZE=600
CHUNK_OVERLAP=80
MAX_UPLOAD_BYTES=10000000
MAX_IMAGE_PIXELS=25000000
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.50
IMAGE_EMBEDDING_ENABLED=false
IMAGE_EMBEDDING_MODEL=Qdrant/clip-ViT-B-32-vision
IMAGE_TEXT_EMBEDDING_MODEL=Qdrant/clip-ViT-B-32-text
MODEL_CACHE_DIR=./data/models/fastembed

# Database
DATABASE_URL=sqlite:///./data/medops.db

# Model and embedding providers
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
EMBEDDING_MODEL_NAME=
MODEL_TIMEOUT_SECONDS=8
MODEL_MAX_RETRIES=1
